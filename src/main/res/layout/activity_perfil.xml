<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/perfilfondo"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Usuario:"
        android:textColor="#000000"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvDisplayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Nome:"
        android:textColor="#000000"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Correo:"
        android:textColor="#000000"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnPecharSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#5D5F5D"
        android:text="Pechar sesión" />

    <Button
        android:id="@+id/btnBorrarConta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF2020"
        android:text="Borrar conta"
        android:textColorLink="#FCFBFD" />
</LinearLayout>