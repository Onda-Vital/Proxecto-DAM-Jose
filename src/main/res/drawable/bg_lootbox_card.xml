<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra falsa suave -->
    <item android:left="2dp" android:top="6dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <solid android:color="#33000000"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>

    <!-- Card -->
    <item>
        <shape>
            <gradient
                android:startColor="#121A33"
                android:centerColor="#111B3D"
                android:endColor="#0B1026"
                android:angle="90"/>
            <stroke android:width="1dp" android:color="#2A3B70"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>

</layer-list>
