<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#5B38FF"
                android:endColor="#1E5BFF"
                android:angle="0"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:startColor="#6E46FF"
                android:endColor="#2B6CFF"
                android:angle="0"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>

</selector>
